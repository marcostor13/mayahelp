# Deployment/orchestration credentials — used ONLY to bootstrap CI/CD
# (create the GitHub repo, push, create the Coolify resources, wire webhooks).
# These are NOT read by the running app (see backend/.env.example for that).
#
# Copy this file to `.env.deploy` (already gitignored) and fill in real values.
# See DEPLOY_SETUP.md for step-by-step instructions on generating each one.

# --- GitHub ---
# Classic PAT with the "repo" scope (needed to create the repo + push).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your GitHub username or the org that should own the repo.
GITHUB_OWNER=your-github-username-or-org
# Repository name to create/use (public, per your choice).
GITHUB_REPO=mayahelp

# --- Coolify ---
# Base URL of your Coolify instance (no trailing slash).
COOLIFY_URL=https://coolify.example.com
# API token from Coolify → Keys & Tokens (needs write/deploy permission).
COOLIFY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Domains (already decided) ---
BACKEND_DOMAIN=apimayahelp.marcostorresalarcon.com
FRONTEND_DOMAIN=mayahelp.marcostorresalarcon.com

# --- Cloudflare (only needed if the server sits behind a Cloudflare Tunnel,
# to inspect/edit DNS records and tunnel ingress rules — see DEPLOY_SETUP.md 3.1) ---
# Permissions needed: Zone.DNS:Edit, Account.Cloudflare Tunnel:Read/Edit.
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx