NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mayahelp?retryWrites=true&w=majority

# Optional: comma-separated DNS servers used to resolve the mongodb+srv:// SRV
# record. Set this if your network/ISP DNS fails to resolve Atlas SRV records
# (e.g. "querySrv ENOTFOUND _mongodb._tcp...").
NODE_DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudflare R2 (S3-compatible) — ticket attachments storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mayahelp-attachments
# Public base URL to serve objects from (R2 public bucket URL or custom domain)
R2_PUBLIC_URL=

# --- NVIDIA API (NIM) — AI ticket drafting & auto-reply ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# --- Resend — transactional email notifications ---
RESEND_API_KEY=
EMAIL_FROM=MayaHelp <notificaciones@mayahelp.marcostorresalarcon.com>

# --- WhatsApp Cloud API — notifications ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Must be a message template already approved in Meta Business Manager for this
# WABA (business-initiated messages require an approved template). The template
# must accept 3 body variables: {{1}} name, {{2}} ticket code, {{3}} subject/message.
WHATSAPP_TEMPLATE_NAME=ticket_notification
WHATSAPP_TEMPLATE_LANGUAGE=es
